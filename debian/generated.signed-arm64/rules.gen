	$(call if_package, linux-image-6.18.3+deb14-test, $(MAKE) -f debian/rules.real setup_image ABINAME='6.18.3+deb14' ARCH='arm64' COMPAT_GNU_TYPE='arm-linux-gnueabihf' C_COMPILER='gcc-15' DESTDIR='$(CURDIR)/debian/linux-image-6.18.3+deb14-test' DH_OPTIONS='-plinux-image-6.18.3+deb14-test' ENABLE_DTB='True' FEATURESET='none' FLAVOUR='test' IMAGE_FILE='arch/arm64/boot/Image' IMAGE_INSTALL_STEM='vmlinuz' INSTALLDOCS_LINK_DOC='linux-base-6.18.3+deb14-test' KCONFIG='debian/config/config.test debian/config/arm64/config.test' KCONFIG_OPTIONS=' -o "BUILD_SALT=\"6.18.3+deb14-test\""' KERNEL_ARCH='arm64' LOCALVERSION='-test' LOCALVERSION_HEADERS='' LOCALVERSION_IMAGE='-test' PACKAGE_NAME='linux-image-6.18.3+deb14-test' SOURCEVERSION='6.18.3-1' SOURCE_BASENAME='linux' SOURCE_SUFFIX='' UPSTREAMVERSION='6.18')
setup_arm64_none_test_image-di:
	$(call if_package, kernel-image-6.18.3+deb14-test-di, $(MAKE) -f debian/rules.real setup_image-di ABINAME='6.18.3+deb14' ARCH='arm64' COMPAT_GNU_TYPE='arm-linux-gnueabihf' C_COMPILER='gcc-15' DESTDIR='$(CURDIR)/debian/kernel-image-6.18.3+deb14-test-di' DH_OPTIONS='-pkernel-image-6.18.3+deb14-test-di' ENABLE_DTB='True' FEATURESET='none' FLAVOUR='test' IMAGE_FILE='arch/arm64/boot/Image' IMAGE_INSTALL_STEM='vmlinuz' KCONFIG='debian/config/config.test debian/config/arm64/config.test' KCONFIG_OPTIONS=' -o "BUILD_SALT=\"6.18.3+deb14-test\""' KERNEL_ARCH='arm64' LOCALVERSION='-test' LOCALVERSION_HEADERS='' LOCALVERSION_IMAGE='-test' PACKAGE_NAME='kernel-image-6.18.3+deb14-test-di' SOURCEVERSION='6.18.3-1' SOURCE_BASENAME='linux' SOURCE_SUFFIX='' UPSTREAMVERSION='6.18')
